# Python 缓存
__pycache__/
*.py[cod]
*$py.class

# 包含敏感凭据、UUID、私钥的具体生成目录
generated-*/
xray-deploy/generated-*/
*.key
*.pem
*-clash.yaml
client-*.json
*.env
secrets/

# 客户端大体积二进制包与数据库文件 (避免 Git 仓库臃肿，请从官方 Release 下载)
*.zip
*.exe
*.dll
*.dat
client-binary-*/
xray-deploy/client-binary-*/

# 运行时日志
*.log

# 操作系统与编辑器临时文件
.DS_Store
Thumbs.db
.vscode/
.idea/
